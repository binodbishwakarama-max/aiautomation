# ─────────────────────────────────────────────
# ReplySync — Environment Variables
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption — used to encrypt tenant secrets at rest (generate a strong random string)
APP_ENCRYPTION_KEY=your_encryption_key_here

# Groq AI
GROQ_API_KEY=your_groq_api_key_here

# Cron — protects the follow-up cron endpoint from unauthorized calls
CRON_SECRET=your_cron_secret_here

# Meta / WhatsApp — webhook verification token (use the same value for both)
META_VERIFY_TOKEN=your_meta_verify_token_here
NEXT_PUBLIC_META_VERIFY_TOKEN=your_meta_verify_token_here

# Hugging Face Access Token (for RAG vector search, 100% free)
HF_ACCESS_TOKEN=your_huggingface_token_here

# Internal API Secret for pg_net webhook calls
INTERNAL_API_SECRET=rs_internal_webhook_secret_key_123

# Meta App OAuth configuration (for Embedded Signup)
NEXT_PUBLIC_META_APP_ID=your_meta_app_id_here
NEXT_PUBLIC_META_CONFIG_ID=your_meta_config_id_here
META_APP_SECRET=your_meta_app_secret_here


